# Datheon Machine Learning and Data Science Internship
# Git ignore configuration

# Python compiled files
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
.venv/
venv/
env/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Python testing and coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Build and distribution files
build/
dist/
*.egg-info/
.eggs/

# IDE and editor configuration
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Temporary and backup files
*.tmp
*.temp
*.bak
*.swp
*~

# Logs
*.log
logs/

# Environment variables and credentials
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Locally generated model files
*.pkl
*.pickle
*.joblib

# Large model checkpoint files
*.h5
*.hdf5
*.pt
*.pth
*.onnx

# Temporary generated datasets
*_temporary.csv
*_temp.csv
*_processed_temp.csv

# Large NumPy data artifacts
*.npy
*.npz